@baseUrl = http://localhost:8080


### =========================================================
### AUTHENTICATION
### =========================================================

### Register a new customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Demo User",
  "email": "demo@example.com",
  "password": "Password123"
}


### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "Password123"
}

> {%
    client.global.set("auth_token", response.body.token);
%}


### Invalid login - expected 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "WrongPassword"
}


### =========================================================
### PRODUCTS
### =========================================================

### Get all products
GET {{baseUrl}}/products
Authorization: Bearer {{auth_token}}


### Get product by ID
GET {{baseUrl}}/products/1
Authorization: Bearer {{auth_token}}


### Search products
GET {{baseUrl}}/products/search?name=lap
Authorization: Bearer {{auth_token}}


### Filter products by category
GET {{baseUrl}}/products/category?category=ELECTRONICS
Authorization: Bearer {{auth_token}}


### Create product
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Demo Headphones",
  "description": "Wireless headphones",
  "price": 79.99,
  "quantity": 20,
  "category": "ELECTRONICS"
}


### Update product
PUT {{baseUrl}}/products/1
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Laptop Pro",
  "description": "Updated laptop",
  "price": 1199.99,
  "quantity": 10,
  "category": "ELECTRONICS"
}


### Invalid product - expected 400
POST {{baseUrl}}/products
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "",
  "description": "Invalid product",
  "price": -10,
  "quantity": -5,
  "category": null
}


### Get nonexistent product - expected 404
GET {{baseUrl}}/products/999
Authorization: Bearer {{auth_token}}


### =========================================================
### CUSTOMERS
### =========================================================

### Get all active customers
GET {{baseUrl}}/customers
Authorization: Bearer {{auth_token}}


### Get own customer profile
GET {{baseUrl}}/customers/4
Authorization: Bearer {{auth_token}}


### Update own customer profile
PUT {{baseUrl}}/customers/4
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "John Updated",
  "email": "john@example.com"
}


### Try to access another customer's profile - expected 403
GET {{baseUrl}}/customers/1
Authorization: Bearer {{auth_token}}


### Try to update another customer's profile - expected 403
PUT {{baseUrl}}/customers/1
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "name": "Unauthorized Update",
  "email": "unauthorized@example.com"
}


### Get nonexistent customer - expected 404
GET {{baseUrl}}/customers/999
Authorization: Bearer {{auth_token}}


### =========================================================
### ORDERS
### =========================================================

### Get own orders
GET {{baseUrl}}/orders
Authorization: Bearer {{auth_token}}


### Get own order by ID
GET {{baseUrl}}/orders/1
Authorization: Bearer {{auth_token}}


### Get own order history through customer
GET {{baseUrl}}/customers/4/orders
Authorization: Bearer {{auth_token}}


### Create order
# Customer is determined from the JWT.
# customerId is intentionally NOT sent.
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "items": [
    {
      "productId": 1,
      "quantity": 2
    }
  ]
}


### Create multi-product order
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "items": [
    {
      "productId": 1,
      "quantity": 1
    },
    {
      "productId": 2,
      "quantity": 2
    }
  ]
}


### Insufficient stock - expected 400
POST {{baseUrl}}/orders
Content-Type: application/json
Authorization: Bearer {{auth_token}}

{
  "items": [
    {
      "productId": 1,
      "quantity": 1000
    }
  ]
}


### Get another customer's order - expected 403
GET {{baseUrl}}/orders/2
Authorization: Bearer {{auth_token}}


### Get nonexistent order - expected 404
GET {{baseUrl}}/orders/999
Authorization: Bearer {{auth_token}}


### =========================================================
### CUSTOMER SOFT DELETE
### =========================================================
### Run these LAST because they deactivate the account.

### Soft delete own customer account
DELETE {{baseUrl}}/customers/4
Authorization: Bearer {{auth_token}}


### Login after soft delete - expected 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "Password123"
}